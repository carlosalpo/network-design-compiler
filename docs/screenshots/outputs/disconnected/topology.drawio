<mxfile host="app.diagrams.net" type="device"><diagram id="network-design" name="Routed topology"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="430"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="heading" value="&lt;b&gt;Two-site routed network reference&lt;/b&gt;&lt;br&gt;Declarative topology — not discovery or verified connectivity. Link IDs refer to links.csv; interfaces and VRFs are in addresses.csv." parent="1" vertex="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;"><mxGeometry x="40" y="20" width="1120" height="60" as="geometry" /></mxCell><mxCell id="site-branch" value="Branch" parent="1" vertex="1" style="swimlane;html=1;whiteSpace=wrap;startSize=36;rounded=1;fillColor=#f5f5f5;strokeColor=#b8c5cc;fontStyle=1;"><mxGeometry x="40" y="120" width="500" height="190" as="geometry" /></mxCell><mxCell id="device-branch-core" value="&lt;b&gt;branch-core&lt;/b&gt;&lt;br&gt;router&lt;br&gt;2 interfaces" parent="site-branch" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#506575;fillColor=#dae8fc;"><mxGeometry x="40" y="60" width="140" height="80" as="geometry" /></mxCell><mxCell id="device-branch-edge" value="&lt;b&gt;branch-edge&lt;/b&gt;&lt;br&gt;router&lt;br&gt;2 interfaces" parent="site-branch" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#506575;fillColor=#dae8fc;"><mxGeometry x="280" y="60" width="140" height="80" as="geometry" /></mxCell><mxCell id="site-hq" value="Headquarters" parent="1" vertex="1" style="swimlane;html=1;whiteSpace=wrap;startSize=36;rounded=1;fillColor=#f5f5f5;strokeColor=#b8c5cc;fontStyle=1;"><mxGeometry x="620" y="120" width="500" height="190" as="geometry" /></mxCell><mxCell id="device-hq-core" value="&lt;b&gt;hq-core&lt;/b&gt;&lt;br&gt;router&lt;br&gt;2 interfaces" parent="site-hq" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#506575;fill